# /etc/mosquitto/acl.d/sensors.acl (sensors-controller, formerly heating-controller)
user sensors-controller
topic write sensors/+/temp/+
topic write sensors/+/state
topic readwrite sensors/+/status

user sc-ingest
topic read sensors/#
# Transitional: the pre-2.3.0 prefix. Remove once the board runs 2.3.0 and the retained heating/ topics are cleared.
topic read heating/#
