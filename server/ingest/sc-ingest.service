[Unit]
Description=sensors-controller MQTT -> PostgreSQL ingest
After=network-online.target mosquitto.service postgresql.service
Wants=network-online.target

[Service]
User=sc_ingest
Group=sc_ingest
EnvironmentFile=/etc/sc-server/secrets.env
ExecStart=/opt/sc-server/venv/bin/python /opt/sc-server/ingest/sc_ingest.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
